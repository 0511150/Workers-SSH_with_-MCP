{
  "name": "workers-ssh-with-mcp",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers WebSSH and authenticated remote MCP gateway",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite --config vite.config.ts",
    "build:web": "vite build --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.frontend.json --noEmit",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "check": "npm run typecheck && npm run test && wrangler deploy --dry-run --outdir .wrangler/build",
    "deploy": "node scripts/deploy.mjs",
    "setup": "node scripts/setup.mjs",
    "types:generate": "wrangler types src/worker-configuration.d.ts --env-interface CloudflareBindings --include-runtime=false"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "esbuild": "0.28.2",
    "miniflare": "5.20261019.2-beta",
    "ssh2": "^1.17.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
